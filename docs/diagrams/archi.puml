@startuml
!pragma layout smetana
skinparam defaultFontName Arial
skinparam backgroundColor #FFFFFF
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam component {
  BackgroundColor #F4F7FB
  BorderColor #4472C4
  FontSize 12
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #808080
  FontSize 13
}
skinparam ArrowColor #333333
skinparam ArrowFontSize 11

package "1. Sources d'entrée" {
  component "Caméra du navigateur\n(trames JPEG)" as CAM
  component "Image ou vidéo\ntéléversée" as IMG
  component "Texte saisi" as TXT
}

package "2. API FastAPI (port 8000)" {
  component "Routes REST\n/translate/*, /spell, /llm" as REST
  component "Flux WebSocket\n/ws/camera" as WS
  component "Sessions, limites de débit,\nCORS, jeton admin" as SEC
}

package "3. Cœur de traduction (hors ligne)" {
  component "Extraction MediaPipe\n→ vecteur 126-D" as LAND
  component "Classifieur 57 signes\nou 31 lettres" as CLF
  component "Seuil 0,30, lissage,\nreconnaissance continue" as SM
  component "Assemblage de phrase\net mode orthographe" as SENT
  component "Traduction locale Argos\n(TN · FR · EN · AR)" as ARG
}

package "4. Correction optionnelle" {
  component "Correcteur LLM\ngarde-fous et dégradation" as LLM
}

package "5. Interfaces" {
  component "Interface web (port 3000)" as WEB
  component "Interface Streamlit\n(port 8501)" as STR
  component "Documentation /docs" as DOC
}

CAM  --> WS   : trames (environ 10/s)
IMG  --> REST : multipart
TXT  --> REST : JSON

WS   --> LAND : trame décodée
REST --> LAND : trame / texte
SEC  ..> WS   : isolation par session
SEC  ..> REST

LAND --> CLF
CLF  --> SM
SM   --> SENT
SENT --> ARG
ARG  --> LLM  : phrase brute (si activé)
LLM  --> WEB  : phrase finale
ARG  --> WEB  : phrase multilingue
REST --> DOC  : schéma OpenAPI
STR  --> REST : appels HTTP

@enduml
