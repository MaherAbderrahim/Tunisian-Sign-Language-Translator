# ── TSL Tunisian Sign Language Translator ──

# API Keys (optional — only needed for LLM correction)
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free
LLM_BASE_URL=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=256
LLM_TIMEOUT=10

# API Server
TSL_HOST=0.0.0.0
TSL_PORT=8000
TSL_CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# Web Frontend
WEB_PORT=3000
