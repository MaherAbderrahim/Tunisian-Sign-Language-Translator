# ── TSL Tunisian Sign Language Translator ──

# API Keys (optional — only needed for LLM correction)
# LLM_MODEL=openrouter/free is a ROTATING alias: any free model may answer,
# and OpenRouter allows only 50 free-model requests/day. Pin a real model for
# deterministic results (ex. meta-llama/llama-3.3-70b-instruct:free).
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=openrouter/free
LLM_BASE_URL=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=10

# LLM security (SSRF guard) — custom/arbitrary endpoints are disabled by
# default. Set ONE of these on the server to opt in:
#   LLM_ALLOW_CUSTOM_BASE_URL=true          → allow any https endpoint
#   LLM_ALLOWED_HOSTS=host1,host2           → allow only these hosts
LLM_ALLOW_CUSTOM_BASE_URL=false
LLM_ALLOWED_HOSTS=

# Admin token: when set, POST /llm/config requires the X-Admin-Token header
TSL_ADMIN_TOKEN=

# API Server
TSL_HOST=0.0.0.0
TSL_PORT=8000
TSL_CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# Web Frontend
WEB_PORT=3000
